component Icon inherits Path {
    in property <string> source;
    in property <color> tint: Theme.ink-2;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.source;
    stroke: root.tint;
    stroke-width: 1.8px;
    fill: transparent;
}

// ============================================================
// 基础控件
// ============================================================

// kind：0 主按钮  1 次按钮  2 文字按钮  3 危险文字按钮  4 危险主按钮（二次确认）
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    border-radius: 8px;
    background: !root.enabled ? Theme.inset
        : root.kind == 0 ? (ta.pressed ? Theme.signal-hover : ta.has-hover ? Theme.signal-hover : Theme.signal)
        : root.kind == 1 ? (ta.pressed ? Theme.inset-strong : ta.has-hover ? Theme.inset-strong : Theme.inset)
        : root.kind == 4 ? Theme.danger
        : (ta.has-hover ? Theme.inset : transparent);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
            // 危险操作平时是灰色，悬停才变红，不抢视线
            color: !root.enabled ? Theme.ink-4 : root.kind == 0 || root.kind == 4 ? #ffffff : root.kind == 3 ? (ta.has-hover ? Theme.danger : Theme.ink-3) : Theme.ink;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> source;
    in property <bool> active;
    in property <length> size: 32px;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: 8px;
    background: ta.pressed ? Theme.inset-strong : (ta.has-hover || root.active) ? Theme.inset : transparent;
    animate background { duration: 120ms; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.source;
        tint: root.active ? Theme.signal : Theme.ink-2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 24px;
    border-radius: 12px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.checked ? Theme.signal : Theme.inset-strong;
    animate background { duration: 160ms; }
    Rectangle {
        width: 18px;
        height: 18px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000030;
        drop-shadow-offset-y: 1px;
        animate x { duration: 180ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <length> radius: 8px;
    callback accepted(string);
    callback escaped();
    property <bool> reveal;
    public function focus-input() {
        input.focus();
    }
    height: 36px;
    border-radius: root.radius;
    background: Theme.inset;
    border-width: 1px;
    border-color: input.has-focus ? Theme.signal : ta.has-hover ? Theme.hairline-strong : Theme.hairline;
    opacity: root.enabled ? 1 : 0.5;
    animate border-color { duration: 140ms; }
    ta := TouchArea { mouse-cursor: MouseCursor.text; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.password ? 2px : 12px;
        spacing: 2px;
        Rectangle {
            horizontal-stretch: 1;
            // 占位文字放在输入框下面，点击会落到输入框上
            if root.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                font-size: 13px;
                color: Theme.ink-4;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                enabled: root.enabled;
                single-line: true;
                font-size: 13px;
                color: Theme.ink;
                vertical-alignment: center;
                selection-background-color: Theme.signal-soft;
                input-type: root.password && !root.reveal ? InputType.password : InputType.text;
                accepted => { root.accepted(self.text); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.escaped();
                        return accept;
                    }
                    reject
                }
            }
        }
        if root.password: VerticalLayout {
            alignment: center;
            IconButton {
                size: 30px;
                source: root.reveal ? Icons.eye-off : Icons.eye;
                clicked => { root.reveal = !root.reveal; }
            }
        }
    }
}

component Stepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 1;
    in property <string> unit;
    in property <bool> enabled: true;
    height: 32px;
    border-radius: 8px;
    background: Theme.inset;
    border-width: 1px;
    border-color: Theme.hairline;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        minus := Rectangle {
            width: 32px;
            border-radius: 7px;
            background: minus-ta.has-hover && root.enabled ? Theme.inset-strong : transparent;
            Text { text: @tr("−"); font-size: 16px; color: Theme.ink-2; horizontal-alignment: center; vertical-alignment: center; }
            minus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.enabled) {
                        root.value = max(root.minimum, root.value - root.step);
                    }
                }
            }
        }
        Text {
            min-width: 76px;
            text: @tr("{} {}", root.value, root.unit);
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        plus := Rectangle {
            width: 32px;
            border-radius: 7px;
            background: plus-ta.has-hover && root.enabled ? Theme.inset-strong : transparent;
            Text { text: @tr("+"); font-size: 16px; color: Theme.ink-2; horizontal-alignment: center; vertical-alignment: center; }
            plus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.enabled) {
                        root.value = min(root.maximum, root.value + root.step);
                    }
                }
            }
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    callback changed(int);
    height: 32px;
    border-radius: 8px;
    background: Theme.inset;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            min-width: 52px;
            horizontal-stretch: 1;
            border-radius: 6px;
            background: i == root.current ? Theme.raised : seg-ta.has-hover ? Theme.inset-strong : transparent;
            drop-shadow-blur: i == root.current && !Theme.dark ? 3px : 0px;
            drop-shadow-color: #0f172a1f;
            drop-shadow-offset-y: 1px;
            animate background { duration: 120ms; }
            Text {
                width: parent.width;
                height: parent.height;
                text: option;
                font-size: 12px;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.ink : Theme.ink-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.enabled) {
                        root.current = i;
                        root.changed(i);
                    }
                }
            }
        }
    }
}

component Select inherits Rectangle {
    callback selected(int);
    in property <[string]> options;
    in-out property <int> current;
    height: 36px;
    border-radius: 8px;
    background: Theme.inset;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.hairline-strong : Theme.hairline;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : "";
            font-size: 13px;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon { width: 16px; height: 16px; source: Icons.chevron-down; tint: Theme.ink-3; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.hairline-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0f172a26;
            drop-shadow-offset-y: 4px;
            VerticalLayout {
                padding: 4px;
                for option[i] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: item-ta.has-hover ? Theme.inset : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: option;
                            font-size: 13px;
                            font-weight: i == root.current ? 600 : 400;
                            color: Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon { width: 16px; height: 16px; source: Icons.check; tint: i == root.current ? Theme.signal : transparent; }
                        }
                    }
                    item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

component RangeSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    in property <bool> enabled: true;
    property <float> ratio: max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));
    height: 24px;
    opacity: root.enabled ? 1 : 0.5;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.inset-strong;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: (root.width - 16px) * root.ratio + 8px;
        height: 4px;
        border-radius: 2px;
        background: Theme.signal;
    }
    Rectangle {
        x: (root.width - self.width) * root.ratio;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 1px;
        border-color: Theme.hairline-strong;
        drop-shadow-blur: 4px;
        drop-shadow-color: #0f172a33;
        drop-shadow-offset-y: 1px;
    }
    function set-from(x: length) {
        if (root.enabled) {
            root.value = root.minimum + max(0, min(1, (x - 8px) / (root.width - 16px))) * (root.maximum - root.minimum);
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// 状态徽标：0 未设置  1 已就绪  2 测试中  3 测试通过  4 测试失败
component KeyBadge inherits Rectangle {
    in property <int> state;
    property <color> tone: root.state == 0 ? Theme.warn : root.state == 2 ? Theme.signal : root.state == 4 ? Theme.danger : Theme.ok;
    height: 22px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: root.state == 1 || root.state == 3 ? Theme.ok-soft : Theme.inset;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tone; }
        }
        Text {
            text: root.state == 0 ? @tr("Not set") : root.state == 1 ? @tr("Configured") : root.state == 2 ? @tr("Testing…") : root.state == 3 ? @tr("Test passed") : @tr("Test failed");
            font-size: 11px;
            font-weight: 500;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// ============================================================
// 设置页的结构件
// ============================================================

component SectionLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.ink-3;
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.hairline;
    drop-shadow-blur: Theme.dark ? 0px : 6px;
    drop-shadow-color: #0f172a0f;
    drop-shadow-offset-y: 1px;
    VerticalLayout {
        @children
    }
}

component Divider inherits HorizontalLayout {
    padding-left: 16px;
    Rectangle { height: 1px; background: Theme.hairline; }
}

// 设置首页的分类入口：图标 + 名称 + 当前状态（有问题时变黄）+ 箭头
component NavRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> summary;
    in property <bool> warn;
    callback clicked;
    height: 62px;
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: 8px;
        background: ta.pressed ? Theme.inset-strong : ta.has-hover ? Theme.inset : transparent;
        animate background { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: Theme.ink-2;
                stroke-width: 1.5px;
                stroke-line-cap: round;
                fill: transparent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 500;
                color: Theme.ink;
            }
            Text {
                min-width: 0px;
                text: root.summary;
                font-size: 12px;
                color: root.warn ? Theme.warn : Theme.ink-3;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                width: 16px;
                height: 16px;
                source: Icons.chevron-right;
                tint: Theme.ink-4;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// “高级选项”展开 / 收起
component Disclosure inherits Rectangle {
    in property <string> text: @tr("Advanced options");
    in-out property <bool> open;
    height: 36px;
    HorizontalLayout {
        alignment: start;
        padding-left: 4px;
        spacing: 4px;
        Text {
            text: root.open ? @tr("Collapse {}", root.text) : root.text;
            font-size: 12px;
            font-weight: 600;
            color: ta.has-hover ? Theme.ink-2 : Theme.ink-3;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                source: root.open ? Icons.chevron-up : Icons.chevron-down;
                tint: Theme.ink-3;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; }
    }
}

// 子页面顶部的一段说明
component PageIntro inherits VerticalLayout {
    in property <string> text;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 2px;
    Text {
        text: root.text;
        font-size: 12px;
        color: Theme.ink-3;
        wrap: word-wrap;
    }
}

// 左边标题 + 说明，右边放控件
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            wrap: word-wrap;
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 11px;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }
    @children
}

// 标题在上，控件占满一行
component FieldBlock inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 6px;
    Text {
        text: root.title;
        font-size: 13px;
        font-weight: 500;
        color: Theme.ink;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        font-size: 11px;
        color: Theme.ink-3;
        wrap: word-wrap;
    }
}

component KeyBlock inherits VerticalLayout {
    in property <string> test-label: @tr("Test");
    in property <int> state;
    in property <string> detail;
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> saved;
    in-out property <string> input;
    callback test();
    callback clear();
    // 清除不可撤销：第一次点只是询问，3 秒内再点才真正清除
    property <bool> confirm-clear;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: @tr("API Key");
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink;
            vertical-alignment: center;
        }
        KeyBadge { state: root.state; }
        Rectangle { horizontal-stretch: 1; }
    }
    TextField {
        password: true;
        placeholder: root.placeholder;
        text <=> root.input;
    }
    HorizontalLayout {
        spacing: 8px;
        Btn {
            text: root.test-label;
            enabled: root.state != 2;
            clicked => { root.test(); }
        }
        if root.saved: Btn {
            text: root.confirm-clear ? @tr("Click again to clear") : @tr("Clear saved key");
            kind: 3;
            clicked => {
                if (root.confirm-clear) {
                    root.confirm-clear = false;
                    root.clear();
                } else {
                    root.confirm-clear = true;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Timer {
        interval: 3s;
        running: root.confirm-clear;
        triggered => { root.confirm-clear = false; }
    }
    if root.detail != "": Text {
        text: root.detail;
        font-size: 11px;
        color: root.state == 4 ? Theme.danger : root.state == 3 ? Theme.ok : Theme.ink-3;
        wrap: word-wrap;
    }
    Text {
        text: root.hint;
        font-size: 11px;
        color: Theme.ink-4;
        wrap: word-wrap;
    }
}

// ============================================================
// 对话页
// ============================================================

// 设置里的插件列表。state：0 未安装  1 已安装  2 有更新  3 内置
export struct PluginRow {
    id: string,
    name: string,
    summary: string,
    state: int,
}

export struct ChatItem {
    // 0 用户  1 助手  2 工具调用  3 系统提示
    role: int,
    text: string,
}

component MessageRow inherits HorizontalLayout {
    in property <ChatItem> item;
    in property <length> max-bubble;
    property <int> role: root.item.role;
    padding-left: root.role == 0 ? 64px : 20px;
    padding-right: root.role == 0 ? 20px : 40px;
    padding-top: root.role >= 2 ? 2px : 8px;
    padding-bottom: root.role >= 2 ? 2px : 8px;
    spacing: 10px;
    alignment: root.role == 0 ? end : root.role == 3 ? center : start;

    // 助手的回答：不用气泡，左边一个小光点
    if root.role == 1: VerticalLayout {
        alignment: start;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: Theme.signal-soft;
            Rectangle {
                x: 7px;
                y: 7px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.signal;
            }
        }
    }
    // 工具调用缩进到和助手正文对齐
    if root.role == 2: Rectangle { width: 22px; }

    Rectangle {
        max-width: root.role == 1 ? root.max-bubble + 32px : root.max-bubble;
        background: root.role == 0 ? Theme.signal-soft : root.role == 2 ? Theme.inset : transparent;
        border-radius: root.role == 0 ? 16px : 6px;
        border-bottom-right-radius: root.role == 0 ? 6px : 6px;
        HorizontalLayout {
            padding-left: root.role == 0 ? 14px : root.role == 2 ? 8px : 0px;
            padding-right: root.role == 0 ? 14px : root.role == 2 ? 10px : 0px;
            padding-top: root.role == 0 ? 9px : root.role == 2 ? 4px : 2px;
            padding-bottom: root.role == 0 ? 9px : root.role == 2 ? 4px : 2px;
            spacing: 6px;
            if root.role == 2: VerticalLayout {
                alignment: center;
                Icon { width: 12px; height: 12px; source: Icons.bolt; tint: Theme.ink-3; stroke-width: 1.6px; }
            }
            Text {
                text: root.item.text;
                wrap: root.role == 2 ? no-wrap : word-wrap;
                overflow: elide;
                font-size: root.role >= 2 ? 11px : 13px;
                color: root.role == 0 ? Theme.signal-ink : root.role == 1 ? Theme.ink : Theme.ink-3;
                horizontal-alignment: root.role == 3 ? center : left;
            }
        }
    }
}

component SuggestionChip inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? Theme.surface : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.hairline-strong : Theme.hairline;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.ink-2;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 聆听光球：整个界面的主角，也是麦克风按钮。
// mode：0 待机  1 正在听  2 思考  3 执行  4 播报  5 已暂停
component Orb inherits Rectangle {
    in property <int> mode;
    callback clicked;
    property <bool> active: root.mode >= 1 && root.mode <= 4;
    // 只有工作时才逐帧刷新，待机时不占 CPU
    property <float> t: root.active ? animation-tick() / 1ms : 0;
    property <length> core-size: ta.pressed ? 60px : 64px;
    width: 132px;
    height: 104px;

    // 正在听：两圈向外扩散的波纹
    for i in 2: Rectangle {
        property <float> phase: mod(root.t / 1700 + i * 0.5, 1.0);
        width: 64px * (1 + self.phase * 0.62);
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.signal;
        opacity: root.mode == 1 ? (1 - self.phase) * 0.55 : 0;
    }
    // 待机：一圈很淡的静态光晕（音箱光环的意象）
    Rectangle {
        width: 64px + 18px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.signal-soft;
        opacity: root.mode == 0 ? 0.8 : 0;
        animate opacity { duration: 200ms; }
    }
    // 播报：外圈随节奏呼吸
    Rectangle {
        property <float> pulse: (sin(root.t / 900 * 360deg) + 1) / 2;
        width: 64px + 14px + self.pulse * 10px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.signal-soft;
        opacity: root.mode == 4 ? 1 : 0;
    }
    core := Rectangle {
        width: root.core-size;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.mode == 0 ? (ta.has-hover ? Theme.raised : Theme.surface)
            : root.mode == 5 ? Theme.inset
            : root.mode == 2 || root.mode == 3 ? Theme.signal-hover
            : Theme.signal;
        border-width: root.mode == 0 || root.mode == 5 ? 1px : 0px;
        border-color: ta.has-hover ? Theme.signal : Theme.hairline-strong;
        drop-shadow-blur: root.active ? 24px : 10px;
        drop-shadow-color: root.active ? Theme.signal-glow : #0f172a1a;
        drop-shadow-offset-y: root.active ? 0px : 2px;
        animate background, border-color { duration: 180ms; }
        animate width { duration: 120ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }

        // 思考 / 执行：三个点依次亮起
        if root.mode == 2 || root.mode == 3: HorizontalLayout {
            alignment: center;
            spacing: 6px;
            for i in 3: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #ffffff;
                    opacity: 0.35 + 0.65 * max(0, sin((root.t / 1000 - i * 0.18) * 360deg));
                }
            }
        }
        if root.mode != 2 && root.mode != 3: Icon {
            width: 26px;
            height: 26px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            stroke-width: 2px;
            source: root.mode == 5 ? Icons.mic-off : Icons.mic;
            tint: root.mode == 0 ? Theme.signal : root.mode == 5 ? Theme.ink-3 : #ffffff;
        }
    }
    ta := TouchArea {
        x: core.x - 6px;
        y: core.y - 6px;
        width: 76px;
        height: 76px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================
// 主窗口
// ============================================================

export component AppWindow inherits Window {
    title: @tr("Aeri");
    // repaint-epoch 一变整个窗口就会重画（见 main.rs 的 hook_native_window）；它永远不会是 -1
    background: root.repaint-epoch == -1 ? Theme.inset : Theme.canvas;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    preferred-width: 580px;
    preferred-height: 760px;
    min-width: 520px;
    min-height: 560px;

    in property <int> repaint-epoch;
    // 状态
    in property <int> status-code;
    in property <string> partial;
    in property <string> memory;
    in property <string> mic-name;
    in property <[ChatItem]> messages;
    in property <int> pending-texts;
    in property <int> voice-test-state: 1;
    in property <string> voice-test-status: @tr("Current voice mode has not been tested");
    in-out property <int> voice-test-epoch;
    in-out property <string> realtime-url;
    in-out property <bool> listening-enabled: true;

    // 设置：大模型
    in-out property <string> llm-key-input;
    in property <string> llm-key-status;
    in property <int> llm-key-state;
    in property <bool> llm-key-saved;
    in-out property <string> llm-base-url;
    in-out property <string> llm-model;
    in-out property <bool> llm-thinking;
    in-out property <int> effort-index;
    in-out property <int> new-conversation-secs;
    // 设置：语音识别
    in-out property <string> asr-key-input;
    in property <string> asr-key-status;
    in property <int> asr-key-state;
    in property <bool> asr-key-saved;
    in-out property <string> asr-url;
    in-out property <string> asr-model;
    in-out property <int> asr-silence-ms;
    in-out property <int> asr-timeout-secs;
    // 设置：唤醒与麦克风
    in-out property <string> wake-words;
    // 已保存的第一个唤醒词，空状态的提示用
    in property <string> first-wake-word: @tr("Hello computer");
    in-out property <float> sensitivity: 0.6;
    in-out property <float> kws-score: 1.5;
    in-out property <bool> follow-up;
    in-out property <bool> duck-others;
    // 软件更新：update-action 0 检查、1 有新版本可安装、2 正在进行
    in-out property <bool> auto-update;
    in-out property <bool> save-history: true;
    in property <string> history-status;
    callback history-open();
    callback history-clear();
    in property <[PluginRow]> plugins;
    in property <string> plugins-status;
    in property <string> plugins-busy;
    callback plugins-refresh();
    callback plugin-action(string);
    in-out property <bool> history-confirm;
    in property <string> app-version;
    in property <string> update-status;
    in property <int> update-action;
    callback update-clicked();
    in-out property <bool> listen-on-start;
    in property <[string]> devices;
    in-out property <int> device-index;
    // 设置：操控、播报、启动
    in-out property <bool> desktop-control;
    in-out property <bool> browser-control;
    in-out property <int> browser-idle-minutes;
    in-out property <string> playwright-package;
    in-out property <float> tts-rate;
    in-out property <bool> show-on-start;
    in-out property <bool> float-ball;
    in-out property <bool> hotkey;
    // 快捷键已生效时是它的名字（空 = 没有可用的快捷键）；note 是设置页的说明
    in property <string> hotkey-label;
    in property <string> hotkey-note;
    in property <bool> task-running;
    in-out property <bool> launch-at-login;
    in-out property <string> settings-note;
    // 0 成功  1 出错  2 普通说明
    in property <int> note-kind;
    in property <bool> settings-dirty;
    // 后台智能体与语音对话
    in-out property <int> executor-index;
    in-out property <int> access-index;
    in-out property <string> agent-workdir;
    in-out property <string> agent-model;
    in-out property <string> executor-status;
    in-out property <int> frontend-index;
    in property <[string]> llm-providers;
    in-out property <int> llm-provider-index;
    in-out property <int> realtime-provider-index;
    in-out property <int> asr-provider-index;
    callback asr-provider-changed(int);
    callback voice-mode-changed(int);
    callback llm-provider-changed(int);
    callback realtime-provider-changed(int);
    in-out property <string> realtime-model;
    in-out property <string> realtime-voice;
    in-out property <bool> barge-in;
    in-out property <bool> full-duplex;
    // 手机控制：开关跟着“保存并应用”；其余是运行状态
    in-out property <bool> remote-enabled;
    in property <bool> remote-running;
    in property <string> remote-status;
    // 正在配对时的 6 位配对码
    in property <string> remote-code;
    in property <int> remote-paired;

    callback send-text(string);
    callback cancel-pending-texts();
    callback test-voice();
    callback talk();
    callback toggle-listening(bool);
    callback clear-chat();
    callback save-settings();
    callback reset-settings();
    callback refresh-devices();
    callback test-llm();
    callback test-asr();
    callback clear-llm-key();
    callback clear-asr-key();
    callback theme-changed();
    in-out property <int> language-index;
    in property <string> language-note;
    callback language-changed(int);
    callback discard-settings();
    callback start-pairing();
    callback cancel-pairing();
    callback unpair-all();

    // 0 对话  1 设置
    in-out property <int> page: 0;
    // 设置里的哪一页：0 首页  1 语音对话  2 唤醒与麦克风  3 大模型  4 电脑操控  5 手机控制  6 外观与启动  7 软件更新
    in-out property <int> settings-sub: 0;
    // 当前设置页的“高级选项”展开了没有（换页时收起）
    property <bool> show-advanced: false;
    // 有未保存的更改时点了返回：底栏改成询问保存还是放弃
    property <bool> leave-pending;
    property <bool> show-keyboard: false;
    property <string> draft;

    public function scroll-to-bottom() {
        chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
    }

    // 打开设置（sub 见 settings-sub）
    public function open-settings(sub: int) {
        root.page = 1;
        root.show-settings(sub);
    }

    function show-settings(sub: int) {
        root.settings-sub = sub;
        root.show-advanced = false;
        settings-scroll.content-y = 0px;
    }

    function leave-settings() {
        if (root.settings-dirty) {
            root.leave-pending = true;
        } else {
            root.settings-note = "";
            root.page = 0;
        }
    }

    function submit() {
        if (root.draft != "") {
            root.send-text(root.draft);
            root.draft = "";
        }
    }

    // 工作中点光球会停下，提示里说清楚
    property <string> orb-caption: root.status-code == 1 ? @tr("Listening · Tap to stop")
        : root.status-code == 2 ? @tr("Thinking · Tap to stop")
        : root.status-code == 3 ? @tr("Working · Tap to stop")
        : root.status-code == 4 ? @tr("Speaking · Tap to stop")
        : root.status-code == 5 ? @tr("Voice wake paused. Tap to talk")
        : @tr("Tap to talk");

    // -------------------- 对话页 --------------------
    Rectangle {
    width: root.width;
    height: root.height;
    visible: root.page == 0;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        // 顶栏
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 12px;
            padding-top: 14px;
            padding-bottom: 10px;
            spacing: 4px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: @tr("Aeri");
                    font-size: 17px;
                    font-weight: 600;
                    letter-spacing: -0.2px;
                    color: Theme.ink;
                }
                Text {
                    text: root.task-running ? @tr("Background task running. You can keep chatting")
                        : root.mic-name == "" ? @tr("Preparing microphone…") : root.mic-name;
                    font-size: 11px;
                    color: root.task-running ? Theme.ok : Theme.ink-3;
                    overflow: elide;
                }
            }
            if root.messages.length > 0: VerticalLayout {
                alignment: center;
                IconButton {
                    source: Icons.trash;
                    clicked => { root.clear-chat(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    source: Icons.sliders;
                    clicked => { root.open-settings(0); }
                }
            }
        }

        // 消息区
        Rectangle {
            vertical-stretch: 1;
            chat-list := ListView {
                width: parent.width;
                height: parent.height;
                visible: root.messages.length > 0;
                for item in root.messages: MessageRow {
                    item: item;
                    max-bubble: chat-list.visible-width * 0.72;
                }
            }
            // 空状态
            if root.messages.length == 0: VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 18px;
                padding-left: 32px;
                padding-right: 32px;
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: @tr("How can I help?");
                        font-size: 22px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: (!root.listening-enabled ? @tr("Voice wake paused. ") : @tr("Say “{}” to wake me. ", root.first-wake-word))
                            + (root.hotkey-label != "" ? @tr("Press {} or tap the orb below", root.hotkey-label) : @tr("Or tap the orb below"));
                        font-size: 13px;
                        color: Theme.ink-3;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                // 还没填百炼的 key：语音对话用不了，先引导去设置
                if root.asr-key-state == 0: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        max-width: 360px;
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: @tr("One more step: add an API key");
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.ink;
                                }
                                Text {
                                    text: @tr("Voice needs a Bailian key. Try typing to check the time or open apps. Chat also needs a language model.");
                                    font-size: 11px;
                                    color: Theme.ink-3;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: @tr("Open settings");
                                    kind: 0;
                                    clicked => { root.open-settings(1); }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    SuggestionChip {
                        text: @tr("What time is it?");
                        clicked => { root.send-text(self.text); }
                    }
                    SuggestionChip {
                        text: @tr("Open Calculator");
                        clicked => { root.send-text(self.text); }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    SuggestionChip {
                        text: @tr("Search for tomorrow’s weather");
                        clicked => { root.send-text(self.text); }
                    }
                    SuggestionChip {
                        text: @tr("Search Bilibili for Python tutorials");
                        clicked => { root.send-text(self.text); }
                    }
                }
            }
        }

        // 边说边出字
        if root.partial != "": HorizontalLayout {
            padding-left: 64px;
            padding-right: 20px;
            padding-bottom: 4px;
            alignment: end;
            Rectangle {
                background: Theme.signal-soft;
                border-radius: 16px;
                border-bottom-right-radius: 6px;
                border-width: 1px;
                border-color: Theme.signal;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 9px;
                    padding-bottom: 9px;
                    Text {
                        text: root.partial;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Theme.signal-ink;
                    }
                }
            }
        }

        if root.pending-texts > 0: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Queued {} messages. They will be handled in order", root.pending-texts);
                font-size: 12px;
                color: Theme.ink-2;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Btn {
                text: @tr("Cancel queue");
                kind: 2;
                clicked => { root.cancel-pending-texts(); }
            }
        }

        // 键盘输入（可选）
        if root.show-keyboard: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 6px;
            spacing: 8px;
            TextField {
                height: 40px;
                radius: 20px;
                placeholder: @tr("Type a command. Enter to send, Esc to hide");
                text <=> root.draft;
                init => { self.focus-input(); }
                accepted => { root.submit(); }
                escaped => { root.show-keyboard = false; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: root.draft == "" ? Theme.inset-strong : send-ta.has-hover ? Theme.signal-hover : Theme.signal;
                    animate background { duration: 120ms; }
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: Icons.arrow-up;
                        tint: root.draft == "" ? Theme.ink-4 : #ffffff;
                        stroke-width: 2.2px;
                    }
                    send-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.submit(); }
                    }
                }
            }
        }

        // 底部：唤醒开关 · 光球 · 键盘
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 4px;
            padding-bottom: 14px;
            VerticalLayout {
                width: 88px;
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    Toggle {
                        checked <=> root.listening-enabled;
                        toggled(on) => { root.toggle-listening(on); }
                    }
                }
                Text {
                    text: @tr("Voice wake");
                    font-size: 11px;
                    color: Theme.ink-3;
                    horizontal-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Orb {
                    mode: root.status-code;
                    clicked => { root.talk(); }
                }
                Text {
                    text: root.orb-caption;
                    font-size: 12px;
                    font-weight: root.status-code >= 1 && root.status-code <= 4 ? 600 : 400;
                    color: root.status-code >= 1 && root.status-code <= 4 ? Theme.signal-ink : Theme.ink-3;
                    horizontal-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                width: 88px;
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    alignment: center;
                    IconButton {
                        size: 36px;
                        source: Icons.keyboard;
                        active: root.show-keyboard;
                        clicked => { root.show-keyboard = !root.show-keyboard; }
                    }
                }
                Text {
                    text: @tr("Type");
                    font-size: 11px;
                    color: Theme.ink-3;
                    horizontal-alignment: center;
                }
            }
        }
    }
    }

    // -------------------- 设置页 --------------------
    // 两级：首页是分类入口（每项下面一行是当前状态，有问题时变黄），点进去是这一类的设置；
    // 很少需要改的项目（服务地址、模型名、细调参数）收在每页底部的“高级选项”里。
    Rectangle {
    width: root.width;
    height: root.height;
    visible: root.page == 1;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 12px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 8px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    source: Icons.back;
                    clicked => {
                        if (root.settings-sub > 0) {
                            root.show-settings(0);
                        } else {
                            root.leave-settings();
                        }
                    }
                }
            }
            Text {
                text: root.settings-sub == 1 ? @tr("Voice chat")
                    : root.settings-sub == 2 ? @tr("Wake & microphone")
                    : root.settings-sub == 3 ? @tr("Language model")
                    : root.settings-sub == 4 ? @tr("Computer control")
                    : root.settings-sub == 5 ? @tr("Phone control")
                    : root.settings-sub == 6 ? @tr("Appearance & startup")
                    : root.settings-sub == 7 ? @tr("Software updates")
                    : root.settings-sub == 8 ? @tr("History")
                    : root.settings-sub == 9 ? @tr("Plugins")
                    : @tr("Settings");
                font-size: 17px;
                font-weight: 600;
                letter-spacing: -0.2px;
                color: Theme.ink;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        settings-scroll := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                // 内容不满一屏时靠上排列，不把卡片拉高
                alignment: start;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 4px;
                padding-bottom: 64px;
                spacing: 8px;

                // ---------- 首页：分类入口 ----------
                if root.settings-sub == 0: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Card {
                        NavRow {
                            icon: Icons.nav-voice;
                            title: @tr("Voice chat");
                            summary: (root.frontend-index == 0 ? @tr("Realtime voice") + @tr(" · ") + (root.realtime-provider-index == 1 ? "OpenAI" : @tr("Alibaba DashScope"))
                                    : @tr("Standard") + @tr(" · ") + (root.asr-provider-index == 0 ? @tr("Local recognition") : root.asr-provider-index == 1 ? "OpenAI" : root.asr-provider-index == 2 ? "Groq" : @tr("Alibaba DashScope")))
                                + @tr(" · ") + (root.asr-key-state == 0 ? @tr("Needs a key") : root.asr-key-state == 4 ? @tr("Key test failed") : @tr("Ready"));
                            warn: root.asr-key-state == 0 || root.asr-key-state == 4;
                            clicked => { root.show-settings(1); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-mic;
                            title: @tr("Wake & microphone");
                            summary: @tr("“{}” · {}", root.first-wake-word, (root.mic-name == "" || root.mic-name == @tr("Microphone unavailable") ? @tr("Microphone unavailable") : root.mic-name));
                            warn: root.mic-name == "" || root.mic-name == @tr("Microphone unavailable");
                            clicked => { root.show-settings(2); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-model;
                            title: @tr("Language model");
                            summary: @tr("{} · {}", root.llm-model, (root.llm-key-state == 0 ? (root.frontend-index == 0 ? @tr("No key; realtime model answers directly") : @tr("No key yet"))
                                    : root.llm-key-state == 4 ? @tr("Key test failed") : @tr("Key ready")));
                            warn: (root.llm-key-state == 0 && root.frontend-index == 1) || root.llm-key-state == 4;
                            clicked => { root.show-settings(3); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-desktop;
                            title: @tr("Computer control");
                            summary: (root.executor-index == 0 ? @tr("Codex") : root.executor-index == 1 ? @tr("Claude Code") : @tr("Built-in assistant")) + @tr(" · ")
                                + (root.access-index == 0 ? @tr("Full access") : root.access-index == 1 ? @tr("Workspace only") : @tr("Read only"))
                                + (!root.desktop-control && !root.browser-control ? @tr(" · Desktop and browser disabled")
                                    : !root.desktop-control ? @tr(" · Desktop control disabled")
                                    : !root.browser-control ? @tr(" · Browser control disabled") : "");
                            clicked => { root.show-settings(4); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-phone;
                            title: @tr("Phone control");
                            summary: !root.remote-enabled ? @tr("Off")
                                : root.remote-paired > 0 ? @tr("On · {} paired phones", root.remote-paired)
                                : @tr("On · No paired phones");
                            clicked => { root.show-settings(5); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-look;
                            title: @tr("Appearance & startup");
                            summary: (Theme.scheme == 1 ? @tr("Light") : Theme.scheme == 2 ? @tr("Dark") : @tr("System")) + @tr(" · ")
                                + (root.launch-at-login ? @tr("Start at login") : @tr("Manual startup"))
                                + (root.float-ball ? @tr(" · Floating orb visible") : "");
                            clicked => { root.show-settings(6); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-update;
                            title: @tr("Software updates");
                            summary: @tr("{} · {}", root.app-version, (root.update-action == 1 ? @tr("Update available")
                                    : root.update-action == 2 ? @tr("Updating…")
                                    : root.auto-update ? @tr("Check daily") : @tr("Auto-check off")));
                            warn: root.update-action == 1;
                            clicked => { root.show-settings(7); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-history;
                            title: @tr("History");
                            summary: root.save-history ? @tr("Keep chats and tasks for 30 days") : @tr("Do not save");
                            clicked => { root.show-settings(8); }
                        }
                        Divider { padding-left: 50px; }
                        NavRow {
                            icon: Icons.nav-plugin;
                            title: @tr("Plugins");
                            summary: @tr("Install plugins to teach Aeri more apps");
                            clicked => {
                                root.show-settings(9);
                                root.plugins-refresh();
                            }
                        }
                    }
                    VerticalLayout {
                        padding-top: 4px;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: center;
                            Btn {
                                text: @tr("Restore defaults");
                                kind: 2;
                                clicked => { root.reset-settings(); }
                            }
                        }
                        if root.memory != "": Text {
                            text: root.memory;
                            font-size: 11px;
                            color: Theme.ink-4;
                            horizontal-alignment: center;
                        }
                    }
                }

                // ---------- 语音对话 ----------
                if root.settings-sub == 1: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Card {
                        if root.frontend-index == 0: FieldBlock {
                            title: @tr("Voice provider");
                            Select {
                                options: [@tr("Alibaba DashScope"), "OpenAI"];
                                current <=> root.realtime-provider-index;
                                selected(index) => { root.realtime-provider-changed(index); }
                            }
                        }
                        if root.frontend-index == 0: Divider { }
                        SettingRow {
                            title: @tr("Conversation mode");
                            description: root.frontend-index == 0 ? @tr("Realtime voice: streaming conversation, needs a provider key") : @tr("Speech to text, then your language model, then Windows speech");
                            VerticalLayout {
                                alignment: center;
                                Segmented {
                                    width: 280px;
                                    options: [@tr("Realtime"), @tr("Standard (recommended)")];
                                    current <=> root.frontend-index;
                                    changed current => { root.voice-mode-changed(self.current); }
                                }
                            }
                        }
                        Divider { }
                        if root.frontend-index == 1: FieldBlock {
                            title: @tr("Speech recognition");
                            hint: @tr("Local is free and works offline after a one-time verified model download.");
                            Select {
                                options: [@tr("Local (offline)"), "OpenAI", "Groq Whisper", @tr("Alibaba DashScope")];
                                current <=> root.asr-provider-index;
                                selected(index) => { root.asr-provider-changed(index); }
                            }
                        }
                        if root.frontend-index == 1: Divider { }
                        KeyBlock {
                            state: root.voice-test-state == 1 ? (root.asr-key-input != "" ? 1 : root.asr-key-state == 0 ? 0 : 1) : root.voice-test-state;
                            detail: root.voice-test-status;
                            test-label: root.frontend-index == 0 ? @tr("Test realtime voice") : @tr("Test speech recognition");
                            placeholder: (root.frontend-index == 0 && root.realtime-provider-index == 1) || (root.frontend-index == 1 && root.asr-provider-index == 1) ? @tr("Optional OpenAI key (shares the OpenAI LLM key)") : root.frontend-index == 1 && root.asr-provider-index == 0 ? @tr("No key needed for local speech recognition") : root.frontend-index == 1 && root.asr-provider-index == 2 ? @tr("Groq API key") : @tr("Alibaba Cloud Model Studio API key");
                            hint: (root.frontend-index == 0 && root.realtime-provider-index == 1) || (root.frontend-index == 1 && root.asr-provider-index == 1) ? @tr("Leave empty to use the OpenAI LLM key or OPENAI_API_KEY") : root.frontend-index == 1 && root.asr-provider-index == 0 ? @tr("Testing downloads and loads the local model the first time") : root.frontend-index == 1 && root.asr-provider-index == 2 ? "console.groq.com" : "bailian.console.aliyun.com";
                            saved: root.asr-key-saved;
                            input <=> root.asr-key-input;
                            test => { root.test-voice(); }
                            clear => { root.clear-asr-key(); }
                        }
                    }
                    SectionLabel { text: @tr("Speech & interruptions"); }
                    Card {
                        SettingRow {
                            title: @tr("Speaking rate");
                            HorizontalLayout {
                                spacing: 10px;
                                RangeSlider {
                                    width: 120px;
                                    minimum: -5;
                                    maximum: 5;
                                    value <=> root.tts-rate;
                                }
                                Text {
                                    width: 34px;
                                    text: round(root.tts-rate);
                                    font-size: 12px;
                                    color: Theme.ink-2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Keep listening after replies");
                            description: @tr("Keep talking without saying the wake word again");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.follow-up; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Interrupt with wake word");
                            description: @tr("Say the wake word while Aeri speaks to make it stop and listen");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.barge-in; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Interrupt directly with headphones");
                            description: @tr("Keep the microphone on while speaking. Turn off when using speakers");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.full-duplex; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Lower other audio during chats");
                            description: @tr("Lower video and music volume, then restore it afterwards");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.duck-others; }
                            }
                        }
                    }
                    Disclosure { open <=> root.show-advanced; }
                    if root.show-advanced && root.frontend-index == 0: Card {
                        FieldBlock {
                            title: @tr("Voice");
                            TextField { text <=> root.realtime-voice; }
                        }
                        Divider { }
                        FieldBlock {
                            title: @tr("Realtime voice model");
                            hint: @tr("Test again after changing the model or voice");
                            TextField { text <=> root.realtime-model; }
                        }
                        Divider { }
                        FieldBlock {
                            title: @tr("Realtime service URL");
                            TextField { text <=> root.realtime-url; }
                        }
                    }
                    if root.show-advanced: SectionLabel { text: @tr("Speech recognition"); }
                    if root.show-advanced: Card {
                        if root.frontend-index == 0: FieldBlock {
                            title: @tr("Recognition service");
                            hint: @tr("Falls back to Speech + LLM if realtime voice cannot connect. Test recognition separately here");
                            HorizontalLayout {
                                spacing: 10px;
                                Btn {
                                    text: @tr("Test speech recognition");
                                    enabled: root.asr-key-state != 2;
                                    clicked => { root.test-asr(); }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.asr-key-status;
                                    color: root.asr-key-state == 4 ? Theme.danger : Theme.ink-3;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if root.frontend-index == 0: Divider { }
                        FieldBlock {
                            title: @tr("Recognition service URL");
                            TextField { text <=> root.asr-url; }
                        }
                        Divider { }
                        FieldBlock {
                            title: @tr("Recognition model");
                            TextField { text <=> root.asr-model; }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("End-of-sentence silence");
                            description: @tr("How long a pause ends a sentence");
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    minimum: 200;
                                    maximum: 6000;
                                    step: 100;
                                    unit: @tr("ms");
                                    value <=> root.asr-silence-ms;
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Wait for speech");
                            description: @tr("Stop waiting if you stay silent after waking Aeri");
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    minimum: 2;
                                    maximum: 30;
                                    unit: @tr("sec");
                                    value <=> root.asr-timeout-secs;
                                }
                            }
                        }
                    }
                }

                // ---------- 唤醒与麦克风 ----------
                if root.settings-sub == 2: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Card {
                        FieldBlock {
                            title: @tr("Microphone");
                            hint: root.mic-name == "" ? @tr("Microphone not open yet") : @tr("Using: {}", root.mic-name);
                            HorizontalLayout {
                                spacing: 8px;
                                Select {
                                    horizontal-stretch: 1;
                                    options: root.devices;
                                    current <=> root.device-index;
                                }
                                IconButton {
                                    size: 36px;
                                    source: Icons.refresh;
                                    clicked => { root.refresh-devices(); }
                                }
                            }
                        }
                        Divider { }
                        FieldBlock {
                            title: @tr("Wake words");
                            hint: @tr("Separate with commas. Choose distinctive phrases to avoid accidental wakes");
                            TextField { text <=> root.wake-words; }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Sensitivity");
                            description: @tr("Higher values wake more easily, including accidental wakes");
                            HorizontalLayout {
                                spacing: 10px;
                                RangeSlider {
                                    width: 120px;
                                    value <=> root.sensitivity;
                                }
                                Text {
                                    width: 34px;
                                    text: @tr("{}%", round(root.sensitivity * 100));
                                    font-size: 12px;
                                    color: Theme.ink-2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Enable voice wake at startup");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.listen-on-start; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Talk with a shortcut");
                            description: root.hotkey-note;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.hotkey; }
                            }
                        }
                    }
                    Disclosure { open <=> root.show-advanced; }
                    if root.show-advanced: Card {
                        SettingRow {
                            title: @tr("Wake word weight");
                            description: @tr("Higher values detect wake words more easily. Lower in noisy environments");
                            HorizontalLayout {
                                spacing: 10px;
                                RangeSlider {
                                    width: 120px;
                                    minimum: 0.5;
                                    maximum: 3;
                                    value <=> root.kws-score;
                                }
                                Text {
                                    width: 34px;
                                    text: round(root.kws-score * 10) / 10;
                                    font-size: 12px;
                                    color: Theme.ink-2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ---------- 大模型 ----------
                if root.settings-sub == 3: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    PageIntro {
                        text: root.frontend-index == 0
                            ? @tr("In realtime mode, a language model handles decisions and tools when configured; realtime voice listens and speaks. Without one, the realtime model answers directly.")
                            : @tr("Required for Speech + LLM mode.");
                    }
                    Card {
                        FieldBlock {
                            title: @tr("Model provider");
                            hint: @tr("Choosing a provider fills in its defaults. Enter that service's key.");
                            Select {
                                options: root.llm-providers;
                                current <=> root.llm-provider-index;
                                selected(index) => { root.llm-provider-changed(index); }
                            }
                        }
                        Divider { }
                        KeyBlock {
                            state: root.llm-key-state;
                            detail: root.llm-key-status;
                            placeholder: @tr("Paste a new key (leave blank to keep it)");
                            hint: @tr("API keys are encrypted on this PC. Ollama needs no key.");
                            saved: root.llm-key-saved;
                            input <=> root.llm-key-input;
                            test => { root.test-llm(); }
                            clear => { root.clear-llm-key(); }
                        }
                        Divider { }
                        FieldBlock {
                            title: @tr("Model");
                            hint: @tr("Use a model available to your account; pull local Ollama models first.");
                            TextField { text <=> root.llm-model; }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Deep thinking");
                            description: @tr("More reliable multi-step actions, with little delay for simple commands");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.llm-thinking; }
                            }
                        }
                        if root.llm-thinking: Divider { }
                        if root.llm-thinking: SettingRow {
                            title: @tr("Thinking effort");
                            VerticalLayout {
                                alignment: center;
                                Segmented {
                                    width: 250px;
                                    options: [@tr("Low"), @tr("High"), @tr("Max")];
                                    current <=> root.effort-index;
                                }
                            }
                        }
                    }
                    Disclosure { open <=> root.show-advanced; }
                    if root.show-advanced: Card {
                        FieldBlock {
                            title: @tr("API URL");
                            hint: @tr("Provider base URL; Custom uses the OpenAI Chat Completions format");
                            TextField { text <=> root.llm-base-url; }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("New conversation after");
                            description: @tr("Forget earlier context after this much silence");
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    minimum: 30;
                                    maximum: 3600;
                                    step: 30;
                                    unit: @tr("sec");
                                    value <=> root.new-conversation-secs;
                                }
                            }
                        }
                    }
                }

                // ---------- 电脑操控 ----------
                if root.settings-sub == 4: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Card {
                        SettingRow {
                            title: @tr("Control desktop apps");
                            description: @tr("Read window controls, click, type, and use shortcuts");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.desktop-control; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Control browser");
                            description: @tr("Open a separate Edge window when needed. Requires Node.js");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.browser-control; }
                            }
                        }
                    }
                    SectionLabel { text: @tr("Delegate longer tasks"); }
                    Card {
                        FieldBlock {
                            title: @tr("Background agent");
                            hint: root.executor-status;
                            Select {
                                options: [@tr("Codex"), @tr("Claude Code"), @tr("Built-in assistant (DeepSeek)")];
                                current <=> root.executor-index;
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Permissions");
                            description: root.access-index == 0 ? @tr("Can do anything without further confirmation. Misheard speech may also be executed") : root.access-index == 1 ? @tr("Only edit files in the workspace; use built-in tools for desktop actions") : @tr("View and answer only; cannot change anything");
                            VerticalLayout {
                                alignment: center;
                                Segmented {
                                    width: 280px;
                                    options: [@tr("Full access"), @tr("Working directory"), @tr("Read only")];
                                    current <=> root.access-index;
                                }
                            }
                        }
                    }
                    Disclosure { open <=> root.show-advanced; }
                    if root.show-advanced: Card {
                        FieldBlock {
                            title: @tr("Working directory");
                            hint: @tr("Leave blank to use your home folder");
                            TextField { text <=> root.agent-workdir; placeholder: @tr("For example, D:\\code"); }
                        }
                        Divider { }
                        FieldBlock {
                            title: @tr("Agent model");
                            hint: @tr("Leave blank to use the agent’s default model");
                            TextField { text <=> root.agent-model; }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Close idle browser after");
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    enabled: root.browser-control;
                                    minimum: 1;
                                    maximum: 120;
                                    unit: @tr("min");
                                    value <=> root.browser-idle-minutes;
                                }
                            }
                        }
                        Divider { }
                        FieldBlock {
                            title: @tr("Playwright package");
                            TextField {
                                enabled: root.browser-control;
                                text <=> root.playwright-package;
                            }
                        }
                    }
                }

                // ---------- 手机控制 ----------
                if root.settings-sub == 5: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    PageIntro {
                        text: @tr("Use the Android app on the same Wi-Fi to type, hold to talk, stop, and adjust volume. Local networks only. Allow Private networks when Windows Firewall asks.");
                    }
                    Card {
                        SettingRow {
                            title: @tr("Allow phone control");
                            description: root.settings-dirty && root.remote-enabled && !root.remote-running ? @tr("Takes effect after saving") : "";
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.remote-enabled; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Pair phones");
                            description: root.remote-status;
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: @tr("Pair a new phone");
                                    enabled: root.remote-running && root.remote-code == "";
                                    clicked => { root.start-pairing(); }
                                }
                            }
                        }
                        if root.remote-code != "": VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 14px;
                            spacing: 4px;
                            Text {
                                text: @tr("Enter this code in the phone app");
                                font-size: 12px;
                                color: Theme.ink-3;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.remote-code;
                                    font-size: 30px;
                                    font-weight: 600;
                                    letter-spacing: 6px;
                                    color: Theme.signal-ink;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        text: @tr("Cancel");
                                        kind: 2;
                                        clicked => { root.cancel-pairing(); }
                                    }
                                }
                            }
                            Text {
                                text: @tr("Valid for 5 minutes; expires after 5 incorrect attempts");
                                font-size: 11px;
                                color: Theme.ink-4;
                            }
                        }
                        if root.remote-paired > 0: Divider { }
                        if root.remote-paired > 0: SettingRow {
                            title: @tr("Unpair all phones");
                            description: @tr("Paired phones will disconnect and need a new pairing code next time");
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: @tr("Unpair");
                                    kind: 3;
                                    clicked => { root.unpair-all(); }
                                }
                            }
                        }
                    }
                }

                // ---------- 外观与启动 ----------
                if root.settings-sub == 6: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Card {
                        SettingRow {
                            title: @tr("Appearance");
                            VerticalLayout {
                                alignment: center;
                                Segmented {
                                    width: 250px;
                                    options: [@tr("System"), @tr("Light"), @tr("Dark")];
                                    current <=> Theme.scheme;
                                    changed => { root.theme-changed(); }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Language");
                            description: root.language-note != "" ? root.language-note : @tr("Applies right away. “System” follows the Windows display language");
                            VerticalLayout {
                                alignment: center;
                                Segmented {
                                    width: 250px;
                                    options: [@tr("System"), "English", "中文"];
                                    current <=> root.language-index;
                                    changed current => { root.language-changed(self.current); }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Show floating orb");
                            description: @tr("Click the desktop orb to open Aeri. Drag it anywhere");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.float-ball; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Start at login");
                            description: @tr("Run in the background when you sign in to Windows");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.launch-at-login; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Open main window at startup");
                            description: @tr("When off, show only the orb. Login startup always stays in the background");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.show-on-start; }
                            }
                        }
                    }
                }

                // ---------- 软件更新 ----------
                if root.settings-sub == 7: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Card {
                        SettingRow {
                            title: @tr("Current version {}", root.app-version);
                            description: root.update-status != "" ? root.update-status : @tr("Download from GitHub, verify, replace, and restart. Settings and API keys are kept");
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    min-width: 120px;
                                    text: root.update-action == 1 ? @tr("Update") : root.update-action == 2 ? @tr("Please wait…") : @tr("Check for updates");
                                    kind: root.update-action == 1 ? 0 : 1;
                                    enabled: root.update-action != 2;
                                    clicked => { root.update-clicked(); }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Check automatically");
                            description: @tr("Check daily and notify in chat. Updates are never installed automatically");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.auto-update; }
                            }
                        }
                    }
                }

                // ---------- 插件 ----------
                if root.settings-sub == 9: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Text {
                        text: @tr("Plugins teach Aeri the fastest way to use an app. They contain instructions only and do not run programs on your computer.");
                        font-size: 12px;
                        color: Theme.ink-3;
                        wrap: word-wrap;
                    }
                    Card {
                        for row[i] in root.plugins: VerticalLayout {
                            if i > 0: Divider { }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 16px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: row.state == 3 ? @tr("{}  · Built-in", row.name) : row.name;
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: Theme.ink;
                                    }
                                    Text {
                                        min-width: 0px;
                                        text: row.summary;
                                        font-size: 11px;
                                        color: Theme.ink-3;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        min-width: 100px;
                                        text: root.plugins-busy == row.id ? @tr("Please wait…")
                                            : row.state == 0 ? @tr("Install") : row.state == 2 ? @tr("Update") : row.state == 1 ? @tr("Uninstall") : @tr("Built-in");
                                        kind: row.state == 0 || row.state == 2 ? 0 : row.state == 1 ? 2 : 1;
                                        enabled: row.state != 3 && root.plugins-busy == "";
                                        clicked => { root.plugin-action(row.id); }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.plugins-status;
                            font-size: 11px;
                            color: Theme.ink-3;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        Btn {
                            text: @tr("Refresh");
                            kind: 2;
                            enabled: root.plugins-busy == "";
                            clicked => { root.plugins-refresh(); }
                        }
                    }
                }

                // ---------- 历史记录 ----------
                if root.settings-sub == 8: VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    Card {
                        SettingRow {
                            title: @tr("View history");
                            description: root.history-status != "" ? root.history-status : @tr("Browse full chats and background task results by day, with search");
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    min-width: 120px;
                                    text: @tr("Open");
                                    kind: 1;
                                    clicked => { root.history-open(); }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Save history");
                            description: @tr("Chats and task results stay on this computer for 30 days. Aeri restores your last chat when reopened");
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked <=> root.save-history; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Clear history");
                            description: root.history-confirm ? @tr("Click Confirm clear again to delete. Cancels automatically after 3 seconds") : @tr("Permanently delete all saved chats and task records");
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    min-width: 120px;
                                    text: root.history-confirm ? @tr("Confirm clear") : @tr("Clear");
                                    kind: root.history-confirm ? 4 : 2;
                                    clicked => {
                                        if (root.history-confirm) {
                                            root.history-confirm = false;
                                            root.history-clear();
                                        } else {
                                            root.history-confirm = true;
                                            confirm-timer.running = true;
                                        }
                                    }
                                }
                                confirm-timer := Timer {
                                    interval: 3s;
                                    running: false;
                                    triggered => {
                                        self.running = false;
                                        root.history-confirm = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // 底部操作栏：只在有改动（或刚保存、出错要提示）时出现
        if root.settings-dirty || root.leave-pending || root.settings-note != "": Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
        if root.settings-dirty || root.leave-pending || root.settings-note != "": HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                text: root.leave-pending ? @tr("Changes have not been saved")
                    : root.settings-note != "" ? root.settings-note
                    : root.settings-dirty ? @tr("Unsaved changes") : "";
                font-size: 12px;
                color: root.leave-pending || (root.settings-note == "" && root.settings-dirty) ? Theme.warn
                    : root.note-kind == 1 ? Theme.danger
                    : root.note-kind == 0 ? Theme.ok : Theme.ink-3;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.leave-pending || root.settings-dirty: Btn {
                text: @tr("Discard changes");
                kind: 2;
                clicked => {
                    root.discard-settings();
                    if (root.leave-pending) {
                        root.leave-pending = false;
                        root.page = 0;
                    }
                }
            }
            if root.leave-pending || root.settings-dirty: Btn {
                text: @tr("Save & apply");
                kind: 0;
                clicked => {
                    root.save-settings();
                    // 保存失败（比如校验没通过）时留在设置页，让人看到原因
                    if (root.leave-pending && !root.settings-dirty) {
                        root.settings-note = "";
                        root.page = 0;
                    }
                    root.leave-pending = false;
                }
            }
        }
    }
    }
}
